# Chave pública (publishable/anon) do projeto Supabase usado pela aplicação.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Mantém quaisquer chaves administrativas apenas no servidor e nunca as uses
# com NEXT_PUBLIC_. A rota de subscrição atual pode continuar a usar a sua chave existente.
