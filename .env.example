# Chave pública do Supabase; o acesso a dados é limitado pelas políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Exclusivamente no servidor: grava resultados validados e subscrições limitadas.
# Nunca usar esta chave numa variável NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
